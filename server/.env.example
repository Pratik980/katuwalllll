PORT=5000
NODE_ENV=development
MONGODB_URI=your_mongodb_connection_string
JWT_SECRET=replace_with_long_random_string
AUTH_JWT_SECRET=replace_with_long_random_string
AUTH_OTP_SECRET=replace_with_long_random_string
LANGUAGE_DEFAULT=en

# Comma-separated frontend origins allowed by CORS. FRONTEND_URL is the active source.
FRONTEND_URL=https://your-frontend-domain.example
ALLOWED_ORIGINS=https://your-frontend-domain.example

# Set TRUST_PROXY=1 only behind a reverse proxy/load balancer (Render, Vercel, nginx).
TRUST_PROXY=1
RATE_LIMIT_MAX=3000

# TEST ONLY: 1 bypasses authentication in the local test harness. Never enable in production.
SKIP_AUTH=0

# Admin bootstrap (used only by: npm run seed:admin)
ADMIN_NAME=Initial Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=a_long_bootstrap_password_16plus_chars

# Email delivery: smtp (default) or formsubmit
EMAIL_PROVIDER=smtp

# SMTP settings (EMAIL_* aliases are preferred; SMTP_* are accepted as fallbacks)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=you@example.com
EMAIL_PASSWORD=your_email_password
EMAIL_FROM=Katuwal Banshabatika <you@example.com>
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@example.com
SMTP_PASSWORD=your_email_password
SMTP_FROM=Katuwal Banshabatika <you@example.com>

# FormSubmit alternative to SMTP (used when EMAIL_PROVIDER=formsubmit)
FORMSUBMIT_ENDPOINT=https://formsubmit.co/ajax/you@example.com
FORMSUBMIT_EMAIL=you@example.com

# Cloudinary credentials for photo uploads
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
